# ─────────────────────────────────────────────
# 必填
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# 訊息平台：telegram（預設）或 discord
#   未設定時，若有填 DISCORD_BOT_TOKEN 會自動視為 discord
# ─────────────────────────────────────────────
MESSAGING_PLATFORM=telegram

# ── Telegram 模式（MESSAGING_PLATFORM=telegram 時必填）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord 模式（MESSAGING_PLATFORM=discord 時必填）──
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# 選填但建議：填了斜線指令會即時註冊到該伺服器（否則為全域指令，最多約 1 小時生效）
DISCORD_GUILD_ID=
# 選填：是否啟用 ! 前綴訊息指令（需在 Discord 開發者後台開啟 MESSAGE CONTENT INTENT）
#   只想用斜線指令的話設為 false，就不必開那個 privileged intent
DISCORD_ENABLE_PREFIX_COMMANDS=true

# ─────────────────────────────────────────────
# 資料來源（皆選填；未填則對應功能停用）
# ─────────────────────────────────────────────
# Finnhub：報價備援 + 新聞快訊
FINNHUB_API_KEY=
# Perplexity Sonar：日報的宏觀即時資訊 + 異動股催化劑
PERPLEXITY_API_KEY=
# 設為 true 可在有金鑰時仍關閉 Perplexity
DISABLE_PERPLEXITY=false
# Financial Modeling Prep：AI 投資人 Agent（基本面 / Buffett / Graham）
FMP_API_KEY=
# 設為 true 可在有金鑰時仍關閉投資人 Agent
DISABLE_AGENTS=false

# ─────────────────────────────────────────────
# 其他（選填）
# ─────────────────────────────────────────────
# 健康檢查 HTTP server 的 port（Zeabur keepalive 用）
PORT=3000
# 設為 true 啟動後立刻跑一次報告（測試用）
RUN_NOW=false
# 搭配 RUN_NOW：stock 或 flash
RUN_NOW_TARGET=stock
