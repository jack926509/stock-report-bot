# ─────────────────────────────────────────────
# 必填
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# Slack（必填）
# ─────────────────────────────────────────────
# Bot User OAuth Token（xoxb- 開頭）— 用來呼叫 Web API 發訊息
#   需要的 OAuth scopes：chat:write, commands, channels:read（或 groups:read）
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxx
# App-Level Token（xapp- 開頭）— 用來連 Socket Mode 接收斜線指令
#   需要 scope：connections:write
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxx
# 目標頻道 ID（C 開頭，可從頻道資訊複製）
SLACK_CHANNEL_ID=C0123456789

# ─────────────────────────────────────────────
# 資料來源（皆選填；未填則對應功能停用）
# ─────────────────────────────────────────────
# Finnhub：報價備援 + 新聞快訊
FINNHUB_API_KEY=
# Perplexity Sonar：日報的宏觀即時資訊 + 異動股催化劑
PERPLEXITY_API_KEY=
# 設為 true 可在有金鑰時仍關閉 Perplexity
DISABLE_PERPLEXITY=false
# Financial Modeling Prep：AI 投資人 Agent（基本面 / Buffett / Graham）
FMP_API_KEY=
# 設為 true 可在有金鑰時仍關閉投資人 Agent
DISABLE_AGENTS=false

# ─────────────────────────────────────────────
# 其他（選填）
# ─────────────────────────────────────────────
# 健康檢查 HTTP server 的 port（Zeabur keepalive 用）
PORT=3000
# 執行狀態 / 每日快照的存放目錄（預設 ./data；檔案系統唯讀時自動略過）
STATE_DIR=./data
# 設為 true 啟動後立刻跑一次報告（測試用，會略過「已產出過」的去重）
RUN_NOW=false
# 搭配 RUN_NOW：stock 或 flash
RUN_NOW_TARGET=stock
